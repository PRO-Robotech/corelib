#!/usr/bin/env bash
# Copyright (c) PRO-Robotech
# SPDX-License-Identifier: Apache-2.0
#
# Хук коммита: правило git в МОМЕНТ коммита. Предикат — scripts/hooks/git-rule.sh
# (правило и решения — в его шапке); провязка — scripts/hooks/install.sh, проба —
# scripts/hooks/git-rule-inject.sh. Исходы: 0 — нарушений нет; 1 — отказ, каждое
# нарушение названо; коммит не записывается.
#
# СУДИТСЯ ТО, ЧТО GIT ЗАПИШЕТ, а не черновик в файле. В редакторе (GIT_EDITOR не
# «:» — git выставляет «:» хуку, когда редактора не было) и при commit.cleanup=
# strip git вырезает строки с `#` как комментарий уже ПОСЛЕ хука: первая строка
# `#<N> ` исчезла бы. Поэтому сообщение чистится здесь тем же способом, а строка
# `#…`, которую git вырежет, — отказ: коммит только `-m`/`-F`.
#
# ПОДПИСЬ сверяется итогом: автора git выставляет хуку сам (с --author, -c
# user.*, локальной настройкой), `git var` отдаёт то, что будет записано.
# Переопределение корня отказывает отдельно, со своей причиной, даже когда
# значение совпадает с корнем: -c/--local/--worktree user.*, GIT_COMMITTER_*,
# GIT_CONFIG_GLOBAL. Корень — `~/.gitconfig` того HOME, под которым идёт коммит.
#
# СЛЕПЫЕ ЗОНЫ. Хук клиентский. Пробой измерено, что его минуют --no-verify
# (коммит и слияние), cherry-pick, revert, rebase без -i, am, commit-tree и
# --cleanup=strip в командной строке (хук видит `#<N> …`, git записывает
# следующую строку). По построению, вне пробы: непровязанный клон, правка через
# веб, слияние на сервере (его сообщение задаётся после проверок). Одинаковые с
# корнем GIT_AUTHOR_* неотличимы от выставленных самим git; ветка, ответвлённая от
# ветки до правила, читается как ветка до правила; что `#<N>` — задача этого
# репозитория, хук не знает. Эти пути держит только суждение по записанным
# коммитам — отправки и запроса; в этом дереве его нет (corelib#25).
set -uo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ ! -f "$here/git-rule.sh" ]; then
    echo "commit-msg ОТКАЗ: нет $here/git-rule.sh — предиката правила нет, судить нечем" >&2
    exit 1
fi
# shellcheck source=scripts/hooks/git-rule.sh
. "$here/git-rule.sh"
git_rule_load_t0 HEAD

file="${1:?commit-msg: git не передал файл сообщения}"
fail=()

# ── ЧТО GIT ЗАПИШЕТ ──────────────────────────────────────────────────────────
comment="$(git config --get core.commentString 2>/dev/null || git config --get core.commentChar 2>/dev/null || printf '#')"
cleanup="$(git config --get commit.cleanup 2>/dev/null || true)"
strip=""
if [ "$comment" = "#" ]; then
    if [ "${GIT_EDITOR:-}" != ":" ]; then
        strip="коммит через редактор"
    elif [ "$cleanup" = strip ]; then
        strip="commit.cleanup=strip"
    fi
fi
if [ -n "$strip" ]; then
    msg="$(git stripspace --strip-comments <"$file")"
    first_raw="$(git stripspace <"$file" | sed -n 1p)"
    if [ "${first_raw:0:1}" = "#" ]; then
        fail+=("$strip: строка «$first_raw» будет вырезана как комментарий — коммитьте -m/-F без редактора")
    fi
else
    msg="$(git stripspace <"$file")"
fi
subj="${msg%%$'\n'*}"
rest=""
[ "$subj" = "$msg" ] || rest="${msg#*$'\n'}"

# ── АТРИБУЦИЯ — у любого коммита ─────────────────────────────────────────────
if attr="$(git_rule_attribution "$msg")"; then
    fail+=("атрибуция в сообщении: «$attr»")
fi

# ── T0: новый коммит или перепись истории ────────────────────────────────────
ident="$(git var GIT_AUTHOR_IDENT)"
at="${ident% *}"; at="${at##* }"
author="${ident% * *}"
history=0
if [ "$GIT_RULE_T0_KNOWN" = 1 ] && [ "$at" -lt "$GIT_RULE_T0" ]; then
    if [ "$(git log -1 --format='%an <%ae> %at' HEAD 2>/dev/null)" = "$author $at" ]; then
        history=1
    else
        fail+=("дата автора $(date -u -d "@$at" '+%F %T' 2>/dev/null || echo "@$at") раньше T0 у нового коммита — дата в прошлом правило не обходит")
    fi
fi

# ── ФОРМА И ВЕТКА — у нового коммита; у переписываемой истории они прежние ───
if [ "$history" = 0 ]; then
    branch="$(git symbolic-ref -q --short HEAD 2>/dev/null || true)"
    git_dir="$(git rev-parse --git-dir)"
    if ! n="$(git_rule_subject_task "$subj")"; then
        fail+=("первая строка не начинается с «#<N> »: «$subj»")
    elif [ -f "$git_dir/MERGE_HEAD" ]; then
        git_rule_merge_form "$subj" ||
            fail+=("слияние — «#<N> merge #<M>: …» либо «#<N> merge main: …», а не «$subj»")
        if git_rule_is_number "$branch" && [ "$n" != "$branch" ]; then
            fail+=("слияние «#$n» на ветке «$branch»: слияние — акт ветки, и номер у него её")
        fi
    fi
    len="$(git_rule_chars "$subj")"
    [ "$len" -le "$GIT_RULE_SUBJECT_MAX" ] ||
        fail+=("первая строка — $len символов, предел $GIT_RULE_SUBJECT_MAX")
    if why="$(git_rule_second_statement "$subj")"; then
        fail+=("первая строка — одно утверждение, а здесь $why: «$subj»")
    fi
    if [ -n "$rest" ]; then
        if [ -n "${rest%%$'\n'*}" ]; then
            fail+=("после первой строки нет пустой строки — git склеит следующую строку с первой в заголовок")
        else
            body="${rest#*$'\n'}"
            lines="$(printf '%s\n' "$body" | wc -l | tr -d ' ')"
            [ "$lines" -le "$GIT_RULE_BODY_MAX" ] ||
                fail+=("тело — $lines строк после git stripspace (пустые между абзацами в счёте), предел $GIT_RULE_BODY_MAX")
        fi
    fi
    if [ -n "$branch" ] && [ "$branch" != main ] && ! git_rule_is_number "$branch" &&
        ! git_rule_before_rule HEAD; then
        fail+=("ветка «$branch»: ветка называется номером задачи (^[0-9]+\$), исключение одно — main; ветка до правила несёт свой коммит с датой автора до T0")
    fi
fi

# ── ПОДПИСЬ — корневая учётная запись ────────────────────────────────────────
[ -z "${GIT_CONFIG_GLOBAL+x}" ] ||
    fail+=("корень перенаправлен окружением GIT_CONFIG_GLOBAL — подпись берётся из ~/.gitconfig")
if root="$(git_rule_root_ident)"; then
    committer="$(git var GIT_COMMITTER_IDENT)"
    committer="${committer% * *}"
    [ "$history" = 1 ] || [ "$author" = "$root" ] ||
        fail+=("автор «$author» — не корневая учётная запись «$root»")
    [ "$committer" = "$root" ] ||
        fail+=("коммиттер «$committer» — не корневая учётная запись «$root»")
else
    fail+=("корневая учётная запись не задана (git config --global user.name / user.email) — подпись сверять не с чем")
fi
over="$(git_rule_ident_overrides)"
[ -z "$over" ] ||
    fail+=("подпись переопределена поверх корня (уровень:ключ): ${over//$'\n'/, } — снять настройку")
for v in GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL; do
    [ -z "${!v+x}" ] || fail+=("подпись переопределена окружением: $v")
done

if [ "${#fail[@]}" -gt 0 ]; then
    {
        echo "commit-msg ОТКАЗ — правило git (scripts/hooks/git-rule.sh; T0 $(git_rule_t0_text)):"
        printf '  · %s\n' "${fail[@]}"
    } >&2
    exit 1
fi
exit 0
